# Local rules for the SOC home lab - deployed to /etc/suricata/rules/local.rules 
# Local SIDs start at 1000000 (range reserved for custom rules). 

# Port scan: many SYN packets from a single source in a short time window alert tcp any any -> $HOME_NET any (msg:"LAB Possible port scan (SYN)"; flags:S; flow:to_server; threshold:type both, track by_src, count 15, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;) 

# SSH brute force: many new connection attempts (SYN) to port 2222 alert tcp any any -> $HOME_NET 2222 (msg:"LAB Possible SSH brute force"; flags:S; flow:to_server; threshold:type both, track by_src, count 10, seconds 30; classtype:attempted-admin; sid:1000002; rev:1;) 

# Path traversal attempt targeting /etc/passwd in HTTP requests alert http any any -> $HOME_NET any (msg:"LAB Path traversal attempt (/etc/passwd)"; flow:established,to_server; http.uri; content:"etc/passwd"; nocase; classtype:web-application-attack; sid:1000003; rev:1;) 
